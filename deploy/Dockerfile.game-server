# The distributable game server: one image, run once per region.
#
# The same binary serves São Paulo, US-E and Europe — only `GOLPE_REGION`
# differs per deployment. Rooms never leave the region they were created in,
# so regions share nothing but this image.
#
# Build:  docker build -f deploy/Dockerfile.game-server -t golpe-server .
# Run:    docker run -e GOLPE_REGION=sa -p 9208:9208 golpe-server
#
# The build compiles the server (and the simulation it shares with the
# client) with tsc and runs the emit on plain node — no tsx in production.
# `node-datachannel` (Geckos' UDP transport) ships a native binary that pnpm
# installs; it is why the runtime stage keeps the full node_modules.

FROM node:22-slim AS build
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json tsconfig.server.json ./
COPY server ./server
COPY src ./src
RUN pnpm exec tsc -p tsconfig.server.json --noEmit false --outDir dist-server --rootDir .

FROM node:22-slim AS runtime
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --prod
COPY --from=build /app/dist-server ./dist
ENV PORT=9208
ENV GOLPE_REGION=local
EXPOSE 9208/udp
EXPOSE 9208/tcp
CMD ["node", "dist/server/index.js"]
