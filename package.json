{
  "name": "vento-aureo",
  "description": "An online-first 2D sword-fighting game: GunZ: The Duel's K-Style rebuilt in two dimensions on a deterministic simulation shared by client and server.",
  "version": "1.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilsonNet/vento-aureo.git"
  },
  "author": "Wilson Neto",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/WilsonNet/vento-aureo/issues"
  },
  "homepage": "https://github.com/WilsonNet/vento-aureo#readme",
  "keywords": [
    "pixijs",
    "ecs",
    "miniplex",
    "geckos",
    "netcode",
    "fighting-game",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.ts",
    "build": "vite build --config vite/config.prod.ts",
    "lint": "biome check --write src server scripts",
    "format": "biome format --write src",
    "knip": "knip",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "test": "vitest run",
    "dev:herdr": "tsx scripts/dev-herdr.ts up",
    "dev:herdr:down": "tsx scripts/dev-herdr.ts down",
    "dev:herdr:status": "tsx scripts/dev-herdr.ts status",
    "dev:herdr:logs": "tsx scripts/dev-herdr.ts logs",
    "diagnose": "tsx scripts/diagnose.ts",
    "deathmatch": "tsx scripts/deathmatch-probe.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.scripts.json",
    "verify": "npm run typecheck && npm run test && npm run build && npm run knip"
  },
  "dependencies": {
    "@geckos.io/client": "^3.1.0",
    "@geckos.io/server": "^3.1.0",
    "miniplex": "^2.0.0",
    "pixi.js": "^8.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "knip": "^6.31.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^4.1.6"
  }
}
