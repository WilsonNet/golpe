{
  "name": "vento-aureo",
  "description": "An online-first 2D sword-fighting game: GunZ: The Duel's K-Style rebuilt in two dimensions on a deterministic simulation shared by client and server.",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilsonNet/vento-aureo.git"
  },
  "author": "Wilson Neto",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/WilsonNet/vento-aureo/issues"
  },
  "homepage": "https://github.com/WilsonNet/vento-aureo#readme",
  "keywords": [
    "pixijs",
    "ecs",
    "miniplex",
    "geckos",
    "netcode",
    "fighting-game",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "lint": "biome check --write src",
    "format": "biome format --write src",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "test": "vitest run",
    "dev:herdr": "node scripts/dev-herdr.mjs up",
    "dev:herdr:down": "node scripts/dev-herdr.mjs down",
    "dev:herdr:status": "node scripts/dev-herdr.mjs status",
    "dev:herdr:logs": "node scripts/dev-herdr.mjs logs",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "dependencies": {
    "@geckos.io/client": "^3.1.0",
    "@geckos.io/server": "^3.1.0",
    "miniplex": "^2.0.0",
    "pixi.js": "^8.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^9.22.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "playwright": "^1.61.1",
    "terser": "^5.28.1",
    "tsx": "^4.22.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.6"
  }
}
