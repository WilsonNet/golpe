{
  "name": "golpe",
  "description": "An online-first 2D sword-fighting game: GunZ: The Duel's K-Style rebuilt in two dimensions on a deterministic simulation shared by client and server.",
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilsonNet/golpe.git"
  },
  "author": "Wilson Neto",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/WilsonNet/golpe/issues"
  },
  "homepage": "https://github.com/WilsonNet/golpe#readme",
  "keywords": [
    "pixijs",
    "ecs",
    "miniplex",
    "geckos",
    "netcode",
    "fighting-game",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.ts",
    "build": "vite build --config vite/config.prod.ts",
    "lint": "biome check --write src server scripts",
    "format": "biome format --write src",
    "knip": "knip",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:server\"",
    "test": "vitest run",
    "dev:herdr": "tsx scripts/dev-herdr.ts up",
    "dev:herdr:down": "tsx scripts/dev-herdr.ts down",
    "dev:herdr:status": "tsx scripts/dev-herdr.ts status",
    "dev:herdr:logs": "tsx scripts/dev-herdr.ts logs",
    "diagnose": "tsx scripts/diagnose.ts",
    "deathmatch": "tsx scripts/deathmatch-probe.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.scripts.json",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run knip"
  },
  "dependencies": {
    "@geckos.io/client": "^3.1.0",
    "@geckos.io/server": "^3.1.0",
    "miniplex": "^2.0.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.7",
    "@fast-check/vitest": "^0.4.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "fast-check": "^4.9.0",
    "knip": "^6.32.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
