{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"scripts/*.ts",
		"scripts/skybox/*/generate.*",
		"scripts/skybox/*/scene.*",
		"vite/*.ts"
	],
	"project": [
		"src/**/*.{ts,tsx}",
		"server/**/*.ts",
		"scripts/**/*.{ts,js,mjs}",
		"vite/**/*.ts"
	],
	"vitest": true,
	"ignoreBinaries": ["ffmpeg", "herdr", "img2webp"]
}
